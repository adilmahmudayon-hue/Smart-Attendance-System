{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Smart Attendance System",
            "type": "shell",
            "command": "gcc",
            "args": [
                "src/main.c",
                "features/REGISTRATION.c",
                "features/present.c",
                "features/RECORD.c",
                "features/course.c",
                "-Ifeatures",
                "-o",
                "attendance.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}